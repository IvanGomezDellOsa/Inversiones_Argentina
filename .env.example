# Configuración de variables de entorno para inversionesargentina.com.ar

# Credenciales de Google AI Studio (Gemini 2.5 Flash + gemini-embedding-2-preview)
GEMINI_API_KEY=tu_api_key_aqui

# API Token de Apify (extracción de X). El scraper usa la API REST v2, no el SDK.
APIFY_API_TOKEN=tu_token_apify_aqui
# Opcional: cambiar el actor de X sin tocar código, por si el actual desaparece
# del store (ya pasó una vez con danek/twitter-scraper-ppr).
# APIFY_ACTOR_ID=danek/twitter-scraper
# Opcional: tope de posts por consulta. El plan FREE de Apify lo limita a 20.
# APIFY_MAX_POSTS=20

# Cadena de conexión Neon PostgreSQL con pgvector habilitado
DATABASE_URL=postgresql://user:password@host/dbname

# Configuración del Bot de Telegram para notificaciones
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui
TELEGRAM_CHANNEL_ID=@inversiones_en_argentina

# API key pública de Google Sheets del portal RIGI (gob.ar). No es un secreto propio:
# está en el JS público de argentina.gob.ar/economia/rigi. Si falta, la fuente RIGI se omite.
RIGI_API_KEY=api_key_publica_del_portal_rigi

# Jev (TypeSafe AI). Activa el filtro semántico de ruido y la deduplicación por
# juicio. Sin esta variable el pipeline funciona igual, con menos precisión.
# La key se crea en https://console.typesafe.ai/keys
# Se acepta JEV_API_KEY como alias.
TYPESAFE_API_KEY=tu_api_key_de_typesafe
